{
  "expo": {
    "name": "Auto Trip AI",
    "slug": "auto-trip-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.autotrip.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.autotrip.ai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "auto-trip-ai",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
